{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/admin/dashboard",
      "destination": "/index.html"
    },
    {
      "source": "/dashboard",
      "destination": "/index.html"
    },
    {
      "source": "/healthz",
      "destination": "https://swagat-backend.onrender.com/healthz"
    },
    {
      "source": "/auth/:path*",
      "destination": "https://swagat-backend.onrender.com/auth/:path*"
    },
    {
      "source": "/apply/:path*",
      "destination": "https://swagat-backend.onrender.com/apply/:path*"
    },
    {
      "source": "/dept/:path*",
      "destination": "https://swagat-backend.onrender.com/dept/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
